{
  "name": "riftbound-scanner",
  "private": true,
  "version": "26.5.12-1",
  "releaseVersion": "2026.05.12.1",
  "license": "MIT",
  "homepage": "https://github.com/Teme1999/Riftbound-Card-Scanner",
  "repository": {
    "type": "git",
    "url": "https://github.com/Teme1999/Riftbound-Card-Scanner.git"
  },
  "type": "module",
  "scripts": {
    "test": "node --test tests/collection.test.mjs tests/scanner.test.mjs tests/quality.test.mjs tests/database.test.mjs tests/prices.test.mjs tests/updater.test.mjs tests/release.test.mjs tests/sound.test.mjs tests/matching.test.mjs",
    "test:release": "node --test tests/release.test.mjs",
    "test:cards": "node --test tests/card-assets.test.mjs",
    "check:assets": "node scripts/check-runtime-assets.mjs",
    "check": "npm test && npm run test:cards && npm run tauri:build-ui && npm run desktop:check && npm run desktop:test",
    "tauri:dev-server": "vite",
    "tauri:build-ui": "npm run check:assets && vite build",
    "desktop:dev": "tauri dev",
    "desktop:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "desktop:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "desktop:build": "npm run check:assets && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^0.263.1",
    "onnxruntime-web": "^1.26.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.4.0",
    "vite-plugin-static-copy": "^1.0.6"
  }
}
